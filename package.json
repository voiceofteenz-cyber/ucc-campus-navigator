{
  "name": "ucc-campus-navigator",
  "version": "1.0.0",
  "private": true,
  "description": "Smart GPS-based walking navigation for the University of Cape Coast campus (React + Leaflet + OpenStreetMap + OSRM foot routing + Express).",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,yellow \"node --watch server/index.js\" \"vite --host\"",
    "dev:https": "concurrently -n api,web -c blue,yellow \"node --watch server/index.js\" \"cross-env HTTPS=1 vite --host\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "fetch-data": "node scripts/fetch-data.js",
    "test": "node --test tests/core.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
